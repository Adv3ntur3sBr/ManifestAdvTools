{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/install",
      "destination": "/install.ps1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}